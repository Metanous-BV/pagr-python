# Copy this file to `.env` (same directory) and fill in your own values.
# `.env` is gitignored — never commit real keys.
#
# Get your keys from Settings → API keys in the Pagr web app. The prefix picks
# the mode: `pagr_test_*` renders are watermarked and batches are capped at 10
# documents; `pagr_prod_*` renders for real and consumes credit.

# Test key — used by most examples.
TEST_KEY_PUBLIC=pagr_test_your_key_here

# Production key — needed by validate.py, render_batch.py and batch_async.py.
# These consume real credit.
PROD_KEY_PUBLIC=pagr_prod_your_key_here

# Optional. Only batch_async.py uses this, for the webhook callback it registers.
# Must be reachable by the Pagr server, so a public URL or a tunnel
# (ngrok, Cloudflare Tunnel) — not localhost.
# Defaults to https://your-app.example/pagr/callback when unset.
#PAGR_CALLBACK_URL=https://your-app.example/pagr/callback
